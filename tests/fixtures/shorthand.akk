# shorthand.akk -- the one-line forms: postfix `if`, the Myanmar one-line
# guard, arrow lambdas, the short `ထဲ` loop particle, and membership.
age သည် 20 ဖြစ်၏။
print("adult") if (age > 18);
print("child") if (age < 18);

# the Myanmar guard: the body follows the header's own `။`, no `ပြီး။`
(age > 18) ဖြစ်ရင်။ "လူကြီး" ကို ပြပါ။

xs မှာ [1, 2, 3] ဖြစ်၏။
print(map(xs, x => x * 2));
print(filter(xs, x => x > 1));
print(reduce(xs, (a, b) => a + b, 0));

# membership: `in` (eng) and `<collection> ထဲ <value>` (Myanmar)
if (2 in xs) {
    print("in ok");
}
( xs ထဲ 9 ) မဖြစ်ရင်။ "no 9" ကို ပြပါ။

# the short collection particle
v သည် xs ထဲ တစ်ခုစီ
    v ကို ပြပါ။
ပြီး။

# a range with an explicit +1 step
i သည် တစ်ခုစီ(1, 3, +1)
    i ကို ပြပါ။
ပြီး။

# a signed step after the collection-form header
k သည် 0, 6 ထဲ တစ်ခုစီ +2 တိုးခြင်းဖြင့်
    k ကို ပြပါ။
ပြီး။
